---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page non trouvée (404)">
  <div class="py-20 text-center max-w-lg mx-auto">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-brand-50 dark:bg-brand-950/80 text-brand-900 dark:text-brand-300 border border-brand-100 dark:border-brand-800/50 font-black text-3xl mb-6 shadow-xs">
      404
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3">
      Page introuvable
    </h1>
    <p class="text-slate-600 dark:text-slate-300 mb-8 leading-relaxed">
      Désolé, la page que vous cherchez n'existe pas ou a été déplacée.
    </p>
    <div class="flex items-center justify-center gap-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-brand-900 hover:bg-brand-800 dark:bg-brand-600 dark:hover:bg-brand-500 transition-colors"
      >
        <span>Retour à l'accueil</span>
      </a>
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
      >
        <span>Explorer les articles</span>
      </a>
    </div>
  </div>
</BaseLayout>
