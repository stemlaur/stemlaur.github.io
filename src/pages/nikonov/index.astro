---
import PostLayout from '../../layouts/PostLayout.astro';
import { Content, frontmatter } from './_nikonov.md';
---

<PostLayout
  title={frontmatter.title}
  image={frontmatter.image}
  tags={frontmatter.tags}
  description={frontmatter.summary}
  readingTime="15 min de lecture"
  id="/nikonov/"
>
  <div class="mb-6 pb-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      Roman court / Nouvelle
    </span>
    <a
      href="/nikonov-en/"
      class="text-xs font-semibold uppercase tracking-wider text-brand-900 dark:text-brand-300 hover:underline flex items-center gap-1 bg-brand-50 dark:bg-brand-950/60 border border-brand-100 dark:border-brand-800/50 px-3 py-1 rounded-full transition-colors"
    >
      <span>Read in English (translation)</span> &rarr;
    </a>
  </div>

  <Content />
</PostLayout>
