---
import PostLayout from '../../layouts/PostLayout.astro';
import { Content, frontmatter } from './_nikonov-en.md';
---

<PostLayout
  title={frontmatter.title}
  image={frontmatter.image}
  tags={frontmatter.tags}
  id="/nikonov-en/"
>
  <div class="mb-6 pb-4 border-b border-slate-200 flex items-center justify-between">
    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">
      Short Novel
    </span>
    <a
      href="/nikonov/"
      class="text-xs font-semibold uppercase tracking-wider text-brand-900 hover:underline flex items-center gap-1 bg-brand-50 px-3 py-1 rounded-full"
    >
      &larr; <span>Version française originale</span>
    </a>
  </div>

  <Content />
</PostLayout>
