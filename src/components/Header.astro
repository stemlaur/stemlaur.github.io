---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'À propos', href: '/about/' },
  { label: 'Blog', href: '/blog/' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-xs transition-all">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a 
      href="/" 
      class="group flex items-center gap-3 font-bold text-brand-900 tracking-tight transition-transform"
      aria-label="Accueil Stemlaur"
    >
      <span class="w-9 h-9 rounded-full bg-brand-900 text-white font-black flex items-center justify-center text-lg shadow-sm transition-transform duration-300 group-hover:scale-110 group-hover:bg-brand-800">
        S
      </span>
      <span class="text-xl hidden sm:inline-block group-hover:text-brand-700 transition-colors">
        Stemlaur
      </span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Navigation principale">
      <a
        href="/"
        class:list={[
          'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors sm:hidden',
          currentPath === '/' ? 'text-brand-900 bg-brand-50' : 'text-slate-600 hover:text-brand-900 hover:bg-slate-100',
        ]}
      >
        Accueil
      </a>
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all duration-200',
              isActive
                ? 'text-brand-900 bg-brand-50/80 font-semibold shadow-xs'
                : 'text-slate-600 hover:text-brand-900 hover:bg-slate-100',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
